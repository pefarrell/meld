#!/bin/zsh

set -eu
unsetopt BG_NICE

MELD_APP="$(cd "$(dirname "$0")/../.." && pwd)"
MELD_BINARY="$MELD_APP/Contents/MacOS/Meld-bin"
MELD_REMOTE="$MELD_APP/Contents/Resources/bin/meld-remote"
MELD_PYTHON=/opt/homebrew/opt/python@3.13/bin/python3.13
DBUS_DAEMON=/opt/homebrew/bin/dbus-daemon
GDBUS=/opt/homebrew/bin/gdbus

if [[ ! -x "$MELD_BINARY" ]]; then
    print -u2 "Meld's bundled executable is missing at $MELD_BINARY"
    exit 1
fi

resolve_existing_path() {
    local argument="$1"
    local directory="$PWD"
    local candidate

    if [[ "$argument" == /* ]]; then
        print -r -- "$argument"
        return
    fi

    if [[ -e "$argument" ]]; then
        print -r -- "$PWD/$argument"
        return
    fi

    # git difftool occasionally starts its tool in a subdirectory while
    # handing it a worktree-relative path. Find that existing file from an
    # ancestor rather than opening an empty/error pane.
    while [[ "$directory" != / ]]; do
        candidate="$directory/$argument"
        if [[ -e "$candidate" ]]; then
            print -r -- "$candidate"
            return
        fi
        directory="${directory:h}"
    done

    print -r -- "$argument"
}

arguments=()
for argument in "$@"; do
    arguments+=("$(resolve_existing_path "$argument")")
done

if [[ ! -x "$MELD_REMOTE" || ! -x "$MELD_PYTHON" ||
      ! -x "$DBUS_DAEMON" || ! -x "$GDBUS" ]]; then
    # GTK's Quartz backend must be started by Launch Services. A direct launch
    # from Git is an unregistered command-line process on current macOS.
    exec /usr/bin/open -W -n "$MELD_APP" --args "${arguments[@]}"
fi

runtime_dir="${TMPDIR%/}/org.gnome.Meld-$UID"
mkdir -p -m 700 "$runtime_dir"
chmod 700 "$runtime_dir"
export DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime_dir/bus"
export MELD_MACOS_BACKGROUND_SERVER=1
export MELD_MACOS_WINDOW_READY="$runtime_dir/window-ready"

if ! "$GDBUS" call \
        --address "$DBUS_SESSION_BUS_ADDRESS" \
        --dest org.freedesktop.DBus \
        --object-path /org/freedesktop/DBus \
        --method org.freedesktop.DBus.ListNames >/dev/null 2>&1; then
    "$DBUS_DAEMON" --session --fork \
        --address="$DBUS_SESSION_BUS_ADDRESS" --nopidfile
fi

owner=$("$GDBUS" call \
    --address "$DBUS_SESSION_BUS_ADDRESS" \
    --dest org.freedesktop.DBus \
    --object-path /org/freedesktop/DBus \
    --method org.freedesktop.DBus.NameHasOwner org.gnome.Meld)

if [[ "$owner" != *true* ]]; then
    rm -f "$MELD_MACOS_WINDOW_READY"
    /usr/bin/open -n "$MELD_APP"
    "$GDBUS" wait --address "$DBUS_SESSION_BUS_ADDRESS" \
        --timeout 10 org.gnome.Meld
fi

# This lightweight client bypasses Launch Services and blocks until Meld
# closes the comparison, preserving git difftool's expected behaviour.
"$MELD_PYTHON" "$MELD_REMOTE" "${arguments[@]}" &
client_pid=$!

# On macOS 14+, background applications cannot bring themselves forward.
# Meld creates this marker after GTK maps its comparison window; only then do
# we ask Launch Services to activate the already-running process.
for attempt in {1..1000}; do
    [[ -e "$MELD_MACOS_WINDOW_READY" ]] && break
    kill -0 "$client_pid" 2>/dev/null || break
    /bin/sleep 0.01
done
if [[ -e "$MELD_MACOS_WINDOW_READY" ]]; then
    /usr/bin/open -a "$MELD_APP"
fi

wait "$client_pid"
